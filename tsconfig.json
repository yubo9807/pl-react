{
  "compilerOptions": {
    "moduleResolution": "node",
    "jsx": "react",
    "target": "ESNext",
    "module": "ESNext",
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "paths": {
      "@/*": ["./test/*"],
      "~/*": ["./*"],
    },
  },
  "include": ["./test", "./core"],
}
